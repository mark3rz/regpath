# Optional server-side fallback key. Users can instead paste their own key on the start page
# (kept in their browser only). A browser-supplied key always wins over this one. Never commit a real value.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Model id used for every call (default: claude-opus-5).
# REGPATH_MODEL=claude-opus-5

# Optional. Generation effort: low | medium | high (default) | xhigh | max. See README "Run time".
# REGPATH_EFFORT=high

# Optional. Set to "off" to generate without live web search (everything is then labelled unverified).
# REGPATH_WEB_SEARCH=on

# Optional. Set to "1" to skip the model entirely and return the bundled Cadence Health sample — for UI work without a key.
# REGPATH_MOCK=0
